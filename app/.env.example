# Template of .env (development) and .env.production: copy it and fill in the values.
# Only secret or technical values here; your name, contact, legal details and social links are in admin > My information.
# Everything starting with NUXT_PUBLIC_ is sent to the browser: never put a secret there.
# Same order as admin > Environment: mode, site, database, admin account, emails, payments, bank, translation.

# ── Mode ─────────────────────────────────────────────────────────────
# development (npm run dev) or production (build)
NODE_ENV=development

# ── Site (public, sent to the browser) ───────────────────────────────
NUXT_PUBLIC_FRONTEND_DOMAIN=http://localhost:3000

# ── Database (MySQL, server only) ────────────────────────────────────
# Locally the one of docker-compose.yml, which reads DB_NAME, DB_PASS and DB_PORT too (DB_PASS = password of root)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=djason_cv
DB_USER=root
DB_PASS=

# ── Admin account (server only) ──────────────────────────────────────
# Created on the first start; SECURITY_ANSWER is asked to reset its password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME="Admin User"
SECURITY_ANSWER=examplecity

# ── Emails (SMTP, server only) ───────────────────────────────────────
# Port 587 with SMTP_SECURE=false, port 465 with SMTP_SECURE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user@example.com
SMTP_PASS=examplepassword

# ── Payments (Stripe) ────────────────────────────────────────────────
# Secret key, server only
STRIPE_SECRET_KEY=STRIPE_SECRET_KEY_HERE
# Signing secret of the webhook /api/stripe/webhook (whsec_...): locally given by "stripe listen", online by the Dashboard
STRIPE_WEBHOOK_SECRET=

# ── Bank (server only) ───────────────────────────────────────────────
# Printed on the invoices and contracts
BANK_IBAN=FR0000000000000000000000000
BANK_BIC=TESTFRXX

# ── Translation (MyMemory, free, no key, server only) ────────────────
# The French typed in the admin fills the English. Empty: about 5,000 characters a day; an email: about 50,000
MYMEMORY_EMAIL=

# ── Area of the address (Google Geocoding API, server only) ────────────
# Region of an address outside France, shown on the site instead of the town (admin > My info). France: geo.api.gouv.fr. Empty: the country
GOOGLE_MAPS_API_KEY=
